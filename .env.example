# Copie ce fichier en `.env` et renseigne tes valeurs.
# Ces variables sont lues côté serveur uniquement (fonctions `api/`).
# Elles n'ont PAS le préfixe VITE_, donc Vite ne les embarque jamais dans le
# bundle envoyé au navigateur — c'est voulu, et il ne faut pas l'ajouter.

# Neon → ton projet → Connection string (pooled).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clé de signature des sessions. Génère la tienne :
#   openssl rand -base64 32
AUTH_SECRET=remplace-moi-par-32-caracteres-aleatoires-minimum

# ---------------------------------------------------------------------------
# Facultatif : réception des pas envoyés par le raccourci iOS (/api/steps).
# Sans ces deux variables, la route refuse toute écriture (503) — le reste de
# l'app fonctionne normalement.

# Jeton que le raccourci met dans son en-tête Authorization. Génère le tien :
#   openssl rand -base64 24
STEPS_TOKEN=

# Le compte alimenté par ce jeton. Il ne donne accès à aucun autre.
STEPS_EMAIL=toi@exemple.com
