# Copie ce fichier en `.env` et renseigne tes valeurs.
# Elles se trouvent dans Supabase → Project Settings → Data API.
# La clé "anon" est publique par nature : elle est protégée par les politiques
# RLS définies dans supabase/schema.sql. Ne mets jamais la clé "service_role" ici.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
